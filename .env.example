# Copy to .env and replace placeholders. Never commit real secrets.

POSTGRES_USER=travel
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=travel_jungle

DATABASE_URL=postgresql+psycopg://travel:change-me-db-password@db:5432/travel_jungle
ADMIN_API_TOKEN=change-me-admin-token
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_SUBMISSIONS_PER_MIN=5
UPLOAD_ROOT=/data/uploads
PUBLIC_BASE_URL=http://localhost:8000
SEED_DEMO=true

# Sibling frontend build context for docker compose (default ../frontend).
# FRONTEND_CONTEXT=../frontend
